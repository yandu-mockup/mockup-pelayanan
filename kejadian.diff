+    // TGR/Non-TGR/Keterlanjuran → potong dari Pensiun/DAPEM saja
+    // BUM/PUM → potong dari THT dulu, sisa dari JKK/JKm
+    function distributePotonganHutang(hutangList, productTypes) {
+      const result = {}; // { productType: nominalPotongan }
+      productTypes.forEach(t => result[t] = 0);
+
+      const tgrTypes = ['TGR', 'Non-TGR', 'Keterlanjuran'];
+      const bumTypes = ['BUM', 'PUM'];
+
+      const pensiunTypes = ['PP', 'DAPEM', 'Pensiun', 'TA', 'NTTA'];
+      const thtTypes = ['TA', 'THT', 'NTTA'];
+      const jkkJkmTypes = ['JKK', 'JKm'];
+
+      hutangList.forEach(h => {
+        const jenis = h.jenis || 'Lainnya';
+        const amt = parseFloat(h.nominal || h.jumlah || 0);
+        if (amt <= 0) return;
+
+        if (tgrTypes.some(t => jenis.toLowerCase().includes(t.toLowerCase()))) {
+          // TGR/Non-TGR/Keterlanjuran → potong dari Tunjangan Terbatas, lalu Pensiun/DAPEM
+          const target = productTypes.find(pt => pt.includes('Tunjangan Terbatas')) || productTypes.find(pt => pensiunTypes.some(pen => pt.includes(pen)));
+          if (target) result[target] = (result[target] || 0) + amt;
+          else result[productTypes[0]] = (result[productTypes[0]] || 0) + amt;
+        } else if (bumTypes.some(t => jenis.toLowerCase().includes(t.toLowerCase()))) {
+          // BUM/PUM → potong dari THT dulu, sisa dari JKK/JKm
+          const thtTarget = productTypes.find(pt => thtTypes.some(t => pt.includes(t)));
+          if (thtTarget) {
+            result[thtTarget] = (result[thtTarget] || 0) + amt;
+          } else {
+            const jkkTarget = productTypes.find(pt => jkkJkmTypes.some(t => pt.includes(t)));
+            if (jkkTarget) result[jkkTarget] = (result[jkkTarget] || 0) + amt;
+            else result[productTypes[0]] = (result[productTypes[0]] || 0) + amt;
+          }
+        } else {
+          // Hutang lain → potong dari produk pertama
+          result[productTypes[0]] = (result[productTypes[0]] || 0) + amt;
+        }
+      });
+
+      return result;
+    }
